{
 "uid": "k2-storage-appliance",
 "title": "K2 / Storage Appliance",
 "description": "At-a-glance storage appliance and zvol PVC status.",
 "tags": [
  "k2",
  "storage"
 ],
 "timezone": "browser",
 "editable": true,
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "graphTooltip": 1,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "zvol",
    "label": "zvol",
    "description": "ZFS dataset backing a PVC. Empty when no k2-iscsi PVCs exist.",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": "label_values(k2_zfs_volume_size_bytes, volume)",
    "refresh": 1,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "sort": 1,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "id": 1,
   "title": "Overall",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "stat",
   "id": 2,
   "title": "Pool ONLINE",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bool",
     "min": 0,
     "max": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "k2_zfs_pool_health{job=\"storage-appliance\",instance=\"k2-st-0e12\"}",
     "legendFormat": "{{pool}}",
     "instant": true
    }
   ]
  },
  {
   "type": "stat",
   "id": 3,
   "title": "Pool key available",
