      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max(k2_boot_slot_passive)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 43,
      "title": "Monitoring health",
      "description": "All of: every fleet target scrapeable, every k2-node-agent collector succeeding, every image check succeeding, and no image check older than 2h. Red means the other panels on this dashboard may be stale or blind, so treat their green with suspicion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Degraded",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "min(up{job=~\"node-exporter|storage-appliance\"}) * min(k2_collector_success) * min(k2_node_image_check_success) * (max(time() - k2_node_image_check_timestamp_seconds) < bool 7200)",
          "instant": true
        }
      ]
    },
    {
      "type": "piechart",
      "id": 44,
      "title": "Flavor",
      "description": "Base OS across the fleet. More than one slice means a partial rollout.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 5,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "value"
        ],
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "values": []
