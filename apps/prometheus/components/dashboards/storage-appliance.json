    }
   ]
  },
  {
   "type": "stat",
   "id": 5,
   "title": "Storage health age",
   "description": "The health job runs hourly; red means its last result is more than two hours old.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 5400
       },
       {
        "color": "red",
        "value": 7200
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "justifyMode": "auto"
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "time() - k2_storage_health_last_run_timestamp_seconds{job=\"storage-appliance\",instance=\"k2-st-0e12\"}",
     "instant": true
    }
   ]
  },
  {
   "type": "gauge",
   "id": 6,
   "title": "Pool capacity",
   "description": "Allocated bytes divided by pool size bytes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 16,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.75
       },
       {
        "color": "red",
        "value": 0.9
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "k2_zfs_pool_alloc_bytes{job=\"storage-appliance\",instance=\"k2-st-0e12\"} / k2_zfs_pool_size_bytes{job=\"storage-appliance\",instance=\"k2-st-0e12\"}",
     "legendFormat": "{{pool}}",
     "instant": true
    }
   ]
  },
  {
   "type": "gauge",
   "id": 7,
   "title": "Pool fragmentation",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 5,
    "w": 4,
    "x": 20,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1,
     "color": {
      "mode": "thresholds"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 0.8
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "showThresholdLabels": false,
    "showThresholdMarkers": true
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "k2_zfs_pool_fragmentation_ratio{job=\"storage-appliance\",instance=\"k2-st-0e12\"}",
     "legendFormat": "{{pool}}",
     "instant": true
    }
   ]
  },
  {
   "type": "row",
   "id": 28,
   "title": "Activity",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "id": 29,
   "title": "Pool throughput (NVMe, physical)",
   "description": "Bytes/s across the four pool NVMe devices. Reads plot up, writes plot down. This is PHYSICAL device traffic, so it includes compression and metadata and will not match the per-PVC panel. Resolution is bounded by the 30s scrape interval, so brief spikes shorter than that are not visible.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 1,
      "fillOpacity": 25,
      "gradientMode": "opacity",
      "showPoints": "never",
      "axisCenteredZero": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "sum(rate(node_disk_read_bytes_total{job=\"storage-appliance\",instance=\"k2-st-0e12\",device=~\"nvme[0-9]+n[0-9]+\"}[$__rate_interval]))",
     "legendFormat": "read",
     "range": true
    },
    {
     "refId": "B",
     "editorMode": "code",
     "expr": "-sum(rate(node_disk_written_bytes_total{job=\"storage-appliance\",instance=\"k2-st-0e12\",device=~\"nvme[0-9]+n[0-9]+\"}[$__rate_interval]))",
     "legendFormat": "write",
     "range": true
    }
   ]
  },
  {
   "type": "timeseries",
   "id": 30,
   "title": "iSCSI fabric throughput (ens19)",
   "description": "Bytes/s on the storage fabric NIC, which carries iSCSI. Transmit is data going TO clients, i.e. their reads; receive is their writes. Plotted tx up / rx down to match the pool panel's read-up convention. Resolution is bounded by the 30s scrape interval, so brief spikes shorter than that are not visible.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 1,
      "fillOpacity": 25,
      "gradientMode": "opacity",
      "showPoints": "never",
      "axisCenteredZero": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "sum(rate(node_network_transmit_bytes_total{job=\"storage-appliance\",instance=\"k2-st-0e12\",device=\"ens19\"}[$__rate_interval]))",
     "legendFormat": "tx (client reads)",
     "range": true
    },
    {
     "refId": "B",
     "editorMode": "code",
     "expr": "-sum(rate(node_network_receive_bytes_total{job=\"storage-appliance\",instance=\"k2-st-0e12\",device=\"ens19\"}[$__rate_interval]))",
     "legendFormat": "rx (client writes)",
     "range": true
    }
   ]
  },
  {
   "type": "timeseries",
   "id": 31,
   "title": "Per-PVC ZFS throughput",
   "description": "Read plus write bytes/s per zvol, at the ZFS layer, so it shows WHICH volume is busy. The join against k2_zfs_volume_pvc_used_bytes only supplies namespace and claim labels; multiplying by zero plus one keeps the value a rate rather than scaling it by used bytes. Resolution is bounded by the 30s scrape interval, so brief spikes shorter than that are not visible.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 1,
      "fillOpacity": 25,
      "gradientMode": "opacity",
      "showPoints": "never",
      "axisCenteredZero": false
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "label_replace(\n  sum by (dataset) (rate(node_zfs_zpool_dataset_nread{job=\"storage-appliance\",instance=\"k2-st-0e12\"}[$__rate_interval]))\n  + sum by (dataset) (rate(node_zfs_zpool_dataset_nwritten{job=\"storage-appliance\",instance=\"k2-st-0e12\"}[$__rate_interval])),\n  \"volume\", \"$1\", \"dataset\", \"(.*)\")\n* on (volume) group_left(namespace, persistentvolumeclaim)\n  (max by (volume, namespace, persistentvolumeclaim) (k2_zfs_volume_pvc_used_bytes{job=\"storage-appliance\",instance=\"k2-st-0e12\"}) * 0 + 1)",
     "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
     "range": true
    }
   ]
  },
  {
   "type": "timeseries",
   "id": 32,
   "title": "Pool IOPS (NVMe, physical)",
   "description": "Completed operations/s across the four pool NVMe devices, reads up and writes down. Pairs with the throughput panel to distinguish many small operations from few large ones. Resolution is bounded by the 30s scrape interval, so brief spikes shorter than that are not visible.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "fieldConfig": {
    "defaults": {
     "unit": "iops",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 1,
      "fillOpacity": 25,
      "gradientMode": "opacity",
      "showPoints": "never",
      "axisCenteredZero": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ],
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "sum(rate(node_disk_reads_completed_total{job=\"storage-appliance\",instance=\"k2-st-0e12\",device=~\"nvme[0-9]+n[0-9]+\"}[$__rate_interval]))",
     "legendFormat": "read",
     "range": true
    },
    {
     "refId": "B",
     "editorMode": "code",
     "expr": "-sum(rate(node_disk_writes_completed_total{job=\"storage-appliance\",instance=\"k2-st-0e12\",device=~\"nvme[0-9]+n[0-9]+\"}[$__rate_interval]))",
     "legendFormat": "write",
     "range": true
    }
   ]
  },
  {
   "type": "row",
   "id": 25,
   "title": "Zvol PVCs",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 25
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "id": 26,
   "title": "Selected PVC size and used",
   "description": "No data means no matching k2-iscsi PVC exists. Legends use namespace/PVC names from the recording-rule join.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 0,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "noValue": "No zvol PVCs",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineInterpolation": "linear",
      "lineWidth": 2,
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "single",
     "sort": "none"
    }
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "expr": "k2_zfs_volume_pvc_size_bytes{volume=~\"${zvol:regex}\"}",
     "legendFormat": "{{namespace}}/{{persistentvolumeclaim}} size",
     "range": true
    },
    {
     "refId": "B",
     "editorMode": "code",
     "expr": "k2_zfs_volume_pvc_used_bytes{volume=~\"${zvol:regex}\"}",
     "legendFormat": "{{namespace}}/{{persistentvolumeclaim}} used",
     "range": true
    }
   ]
  },
  {
   "type": "table",
   "id": 27,
   "title": "All zvol PVCs",
   "description": "Sorted by percent used (used / provisioned), highest first. Percent is red above 70%. Provisioning is thin, so used is what the volume actually occupies on the pool, not what it reserves. No data means no zvol-backed PVCs exist.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 10,
    "w": 12,
    "x": 12,
    "y": 26
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "^(size|used)$"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "used %"
      },
      "properties": [
       {
        "id": "unit",
        "value": "percentunit"
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 1
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "color": "green",
           "value": null
          },
          {
           "color": "red",
           "value": 0.7
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "sortBy": [
     {
      "displayName": "used %",
      "desc": true
     }
    ],
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   },
   "targets": [
    {
     "refId": "A",
     "editorMode": "code",
     "format": "table",
     "instant": true,
     "expr": "max by (namespace, persistentvolumeclaim) (k2_zfs_volume_pvc_size_bytes)"
    },
    {
     "refId": "B",
     "editorMode": "code",
     "format": "table",
     "instant": true,
     "expr": "max by (namespace, persistentvolumeclaim) (k2_zfs_volume_pvc_used_bytes)"
    },
    {
     "refId": "C",
     "editorMode": "code",
     "format": "table",
     "instant": true,
     "expr": "max by (namespace, persistentvolumeclaim) (k2_zfs_volume_pvc_used_bytes) / max by (namespace, persistentvolumeclaim) (k2_zfs_volume_pvc_size_bytes)"
    }
   ],
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "indexByName": {
       "namespace": 0,
       "persistentvolumeclaim": 1,
       "Value #A": 3,
       "Value #B": 4,
       "Value #C": 2
      },
      "renameByName": {
       "persistentvolumeclaim": "PVC",
       "Value #A": "size",
