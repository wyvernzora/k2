    {
      "type": "table",
      "id": 29,
      "title": "K2 node builds",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "node",
            "desc": false
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "expr": "max by (instance, flavor, flavor_version, kairos_version, kairos_agent_version, kubernetes_version, role, source_commit) (k2_node_build_info)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "instance": 0,
              "role": 1,
              "flavor": 2,
              "flavor_version": 3,
              "kairos_version": 4,
              "kairos_agent_version": 5,
              "kubernetes_version": 6,
              "source_commit": 7
            },
            "renameByName": {
              "instance": "node",
              "role": "role",
              "flavor": "flavor",
              "flavor_version": "flavor version",
              "kairos_version": "Kairos",
              "kairos_agent_version": "Kairos agent",
              "kubernetes_version": "Kubernetes",
              "source_commit": "source commit"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "id": 30,
      "title": "K2 node image checks",
      "description": "Upgrade state is shown beside check success and age; a missing upgrade value after a failed check is not treated as up to date.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "upgrade available"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bool"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "check succeeded"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bool"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "check age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 5400
                    },
                    {
                      "color": "red",
                      "value": 7200
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "node",
            "desc": false
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "expr": "max by (instance) (k2_node_image_upgrade_available)"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "expr": "max by (instance) (k2_node_image_check_success)"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "expr": "time() - max by (instance) (k2_node_image_check_timestamp_seconds)"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "instance": "node",
              "Value #A": "upgrade available",
              "Value #B": "check succeeded",
              "Value #C": "check age"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "id": 31,
      "title": "K2 node boot assessment",
      "description": "GRUB rolls a node back to its passive slot when it finds boot_assessment_tentative still set. An armed node looks healthy until its NEXT reboot, whenever that happens to be \u2014 k2-pi-35d9 sat armed for 30 days and then reverted to a months-old image during unrelated rack work. Armed is the warning; passive boot and upgrade failure mean it already happened. Nodes appear here only once they run an image that reports these metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "armed"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bool"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
