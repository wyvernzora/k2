{
  "uid": "k2-fleet",
  "title": "K2 / Fleet",
  "description": "Image build and upgrade state for every K2 node: control planes, workers, and the storage appliance.",
  "tags": [
    "k2",
    "fleet"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "id": 40,
      "title": "Upgrade available",
      "description": "Any node whose floating image tag has moved past the digest it runs. Drill into K2 node image checks for which.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "Yes",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "no data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "max(k2_node_image_upgrade_available)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 41,
      "title": "Boot assessment armed",
      "description": "Any node carrying a stale boot_assessment_tentative sentinel. Such a node looks healthy until its NEXT reboot, then rolls back to its passive slot. Drill into K2 node boot assessment.",
