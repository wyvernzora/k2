                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "upgrade failure"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bool"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
